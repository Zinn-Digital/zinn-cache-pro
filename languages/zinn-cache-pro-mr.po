#: tpl/cache/settings-cache.tpl.php:76
#, php-format
msgid "Privately cache commenters that have pending comments. Disabling this option will serve non-cacheable pages to commenters. (LSWS %s required)"
msgstr "प्रलंबित टिप्पण्या असलेल्या टिप्पणीकर्त्यांना खाजगीरित्या कॅशे करा. हा पर्याय अक्षम केल्याने टिप्पणीकर्त्यांना कॅशे न करता येणारी पृष्ठे सर्व्ह केली जातील. (LSWS %s आवश्यक)"

