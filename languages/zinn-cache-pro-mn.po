msgstr "Лог файлын хамгийн дээд хэмжээг заана уу."

#: tpl/toolbox/settings-debug.tpl.php:147
msgid "Shorten query strings in the debug log to improve readability."
msgstr "Уншихад хялбар болгох үүднээс дибаг лог дахь хүсэлтийн мөрүүдийг богиносгоно уу."

#: tpl/toolbox/settings-debug.tpl.php:160
