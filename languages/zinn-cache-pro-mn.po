msgstr "Боломжтой команднуудын талаарх нэмэлт мэдээллийг эндээс олох боломжтой."

#: tpl/toolbox/settings-debug.tpl.php:119
msgid "Advanced level will log more details."
msgstr "Дешир төвшний тохиргоо илүү олон дэлгэрэнгүй мэдээллийг бүртгэх болно."

#: tpl/toolbox/settings-debug.tpl.php:130
msgid "MB"
msgstr "МБ"

#: tpl/toolbox/settings-debug.tpl.php:132
