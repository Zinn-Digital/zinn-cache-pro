#: tpl/page_optm/settings_media.tpl.php:296
#, php-format
msgid "Filter %s available to change threshold."
msgstr "Босго хэмжээг өөрчлөхөд %s шүүлтүүр ашиглах боломжтой."

#: tpl/page_optm/settings_media_exc.tpl.php:31
msgid "Listed images will not be lazy loaded."
msgstr "Жагсаалтад орсон зургуудад хойшлуулсан ачаалал (lazy loading) ашиглахгүй."

#: tpl/page_optm/settings_media_exc.tpl.php:34
msgid "Useful for above-the-fold images causing CLS (a Core Web Vitals metric)."
msgstr "CLS (Core Web Vitals хэмжүүр)-ийг үүсгэж буй хуудасны эхний дэлгэцэнд харагдах зургуудад хэрэгтэй."

