msgstr "Datoteku nije bilo moguće pročitati. Odaberite datoteku postavki izvezenu iz Zinn® dodatka."

#: zinn/class-zinn-cache-pro-admin-ui.php:1182
msgid "That file is too large to be a settings export."
msgstr "Ta je datoteka prevelika da bi bila izvoz postavki."

#: zinn/class-zinn-cache-pro-admin-ui.php:1195
msgid "That file is not a Zinn® settings export."
msgstr "Ta datoteka nije izvoz Zinn® postavki."

#. translators: %s: the plugin slug the file was exported from.
#: zinn/class-zinn-cache-pro-admin-ui.php:1203
#, php-format
msgid "That file was exported from a different plugin (%s), so importing it here would store settings this plugin does not understand."
msgstr "Ta je datoteka izvezena iz drugog dodatka (%s), pa bi njen uvoz ovdje pohranio postavke koje ovaj dodatak ne prepoznaje."

#. translators: %d: how many settings were imported.
#: zinn/class-zinn-cache-pro-admin-ui.php:1233
#, php-format
msgid "%d setting imported. Passwords and API keys are never in an export, so enter those again."
msgid_plural "%d settings imported. Passwords and API keys are never in an export, so enter those again."
msgstr[0] "%d postavka je uvezena. Zaporke i API ključevi nikada nisu uključeni u izvoz, stoga ih ponovno unesite."
msgstr[1] "Uvezeno je %d postavki. Lozinke i API ključevi nikada nisu uključeni u izvoz, stoga ih ponovno unesite."
msgstr[2] "Uvezeno je %d postavki. Lozinke i API ključevi nikada nisu uključeni u izvoz, stoga ih ponovno unesite."

#: zinn/class-zinn-cache-pro-connection.php:58
msgid "Connected"
msgstr "Povezano"

#: zinn/class-zinn-cache-pro-connection.php:60
msgid "Connecting…"
msgstr "Povezivanje…"

#: zinn/class-zinn-cache-pro-connection.php:62
msgid "Connected, but something needs attention"
msgstr "Povezano, ali nešto zahtijeva pažnju"

#: zinn/class-zinn-cache-pro-connection.php:64
msgid "Not connected"
msgstr "Nije povezano"

#: zinn/class-zinn-cache-pro-connection.php:66
msgid "Running on your own account"
msgstr "Izvodi se na vašem računu"

#: zinn/class-zinn-cache-pro-connection.php:68
msgid "We could not check this"
msgstr "Nismo mogli ovo provjeriti"

#: zinn/class-zinn-cache-pro-connection.php:93
msgid "This plugin did not say why. Send a diagnostics report and we will look."
msgstr "Ovaj dodatak nije naveo razlog. Pošaljite izvješće o dijagnostici i mi ćemo provjeriti."

#: zinn/class-zinn-cache-pro-connection.php:161
msgid "Connection status"
msgstr "Status veze"

#. translators: %s: a human-readable interval such as "5 minutes".
#: zinn/class-zinn-cache-pro-connection.php:189
#, php-format
msgid "Last checked %s ago."
msgstr "Zadnja provjera prije %s."

#: zinn/class-zinn-cache-pro-connection.php:251
msgid "(opens in a new tab)"
msgstr "(otvara se u novoj kartici)"

#: zinn/class-zinn-cache-pro-diagnostics.php:199
msgid "Send this to Zinn® support"
msgstr "Pošaljite ovo podršci za Zinn®"

#: zinn/class-zinn-cache-pro-diagnostics.php:201
msgid "This is exactly what will be sent — nothing else, and nothing hidden. Your passwords, tokens and API keys are not in it."
msgstr "To je točno ono što će biti poslano — ništa drugo i ništa skriveno. Vaše lozinke, tokeni i API ključevi nisu u tome."

#: zinn/class-zinn-cache-pro-diagnostics.php:204
msgid "The diagnostics report that will be sent"
msgstr "Dijagnostičko izvješće koje će biti poslano"

#: zinn/class-zinn-cache-pro-diagnostics.php:207
msgid "Copy to clipboard"
msgstr "Kopiraj u međuspremnik"

#: zinn/class-zinn-cache-pro-diagnostics.php:214
msgid "Send this report to Zinn® support"
msgstr "Pošaljite ovo izvješće Zinn® podršci"

#: zinn/class-zinn-cache-pro-diagnostics.php:216
msgid "We open a support ticket for you and reply by email. If you would rather not send it, copy it above and paste it into a ticket yourself."
msgstr "Otvaramo vam zahtjev za podršku i odgovaramo e-poštom. Ako ga radije ne biste poslali, kopirajte ga iznad i sami ga zalijepite u zahtjev."

#: zinn/class-zinn-cache-pro-diagnostics.php:228
msgid "Copied"
msgstr "Kopirano"

#. translators: %s: the transport error reported by WordPress.
#: zinn/class-zinn-cache-pro-diagnostics.php:274
#, php-format
msgid "We could not reach Zinn Digital® from this server (%s). Copy the report above and open a ticket instead — nothing about your settings is wrong."
msgstr "Nismo mogli dosegnuti Zinn Digital® s ovog poslužitelja (%s). Umjesto toga kopirajte gore navedeno izvješće i otvorite zahtjev — s vašim postavkama nije ništa u redu."

#: zinn/class-zinn-cache-pro-diagnostics.php:288
msgid "Sent. Zinn® support has your report and will reply by email."
msgstr "Podrška za Zinn® primila je vaše izvješće i odgovorit će vam putem e-pošte."

#. translators: %s: the support reference for the report just sent.
#: zinn/class-zinn-cache-pro-diagnostics.php:291
#, php-format
msgid "Sent. Zinn® support has your report — reference %s — and will reply by email."
msgstr "Podrška za Zinn® primila je vaše izvješće – referenca %s – i odgovorit će putem e-pošte."

#: zinn/class-zinn-cache-pro-diagnostics.php:300
msgid "You have sent several reports in a short time. Wait a few minutes and try again — the earlier ones did arrive."
msgstr "Poslali ste nekoliko izvješća u kratkom vremenu. Pričekajte nekoliko minuta i pokušajte ponovno – prethodna su uspješno stigla."

#: zinn/class-zinn-cache-pro-diagnostics.php:307
msgid "Zinn Digital® could not accept the report just now — that is our end, not yours. Try again shortly, or copy the report above into a ticket."
msgstr "Zinn Digital® trenutno nije mogao prihvatiti izvješće — problem je s naše strane, ne s vaše. Pokušajte ponovno uskoro ili kopirajte gornje izvješće u tiket."

#. translators: %d: the HTTP status code the server returned.
#: zinn/class-zinn-cache-pro-diagnostics.php:315
#, php-format
msgid "The report was refused (HTTP %d). Copy it above and open a ticket, quoting that number."
msgstr "Izvješće je odbijeno (HTTP %d). Kopirajte ga gore i otvorite zahtjev s navedenim brojem."

