#: src/error.cls.php:198
msgid "Previous request too recent. Please try again later."
msgstr "முந்தைய கோரிக்கை மிகவும் சமீபத்தில்தான் கொடுக்கப்பட்டுள்ளது. சிறிது நேரம் கழித்து மீண்டும் முயற்சிக்கவும்."

#: src/error.cls.php:203
#, php-format
msgid "Previous request too recent. Please try again after %s."
msgstr "முந்தைய கோரிக்கை மிகவும் சமீபத்தில்தான் கொடுக்கப்பட்டுள்ளது. தயவுசெய்து %s கழித்து மீண்டும் முயற்சிக்கவும்."

#: src/error.cls.php:209
