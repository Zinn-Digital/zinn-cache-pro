msgstr "Chaguo hili litaondoa lebo zote za %s kutoka kwa HTML."

#: tpl/page_optm/settings_js.tpl.php:33
msgid "Minify JS files and inline JS codes."
msgstr "Fupisha faili za JS na uweke misimbo ya JS ndani."

#: tpl/page_optm/settings_js.tpl.php:47
