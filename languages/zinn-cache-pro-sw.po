msgstr "Chelewesha uonyeshaji wa vipengele vya HTML vilivyo nje ya skrini kupitia kiteua chake."

#: tpl/page_optm/settings_html.tpl.php:106
msgid "When minifying HTML do not discard comments that match a specified pattern."
msgstr "Unapopunguza ukubwa wa HTML, usitupe maoni yanayolingana na muundo maalum."

#: tpl/page_optm/settings_html.tpl.php:108
#, php-format
msgid "If comment to be kept is like: %1$s write: %2$s"
msgstr "Ikiwa maoni ya kuwekwa ni kama: %1$s andika: %2$s"

