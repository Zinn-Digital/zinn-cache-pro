msgstr "Tengeneza LQIP kiotomatiki chinichini kupitia foleni inayotegemea cron."

#: tpl/page_optm/settings_media.tpl.php:175
#, php-format
msgid "If set to %1$s, before the placeholder is localized, the %2$s configuration will be used."
msgstr "Ikiwa imewekwa kuwa %1$s, kabla ya kishika nafasi kubinafsishwa, usanidi wa %2$s utatumika."

