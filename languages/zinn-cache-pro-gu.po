#: zinn/class-zinn-cache-pro-admin-ui.php:910
msgid "Import a settings file"
msgstr "સેટિંગ્સ ફાઇલ આયાત કરો"

#: zinn/class-zinn-cache-pro-admin-ui.php:914
msgid "Exported files never contain passwords, tokens or API keys — you will need to enter those again on the new site."
msgstr "નિકાસ કરેલી ફાઇલોમાં ક્યારેય પાસવર્ડ્સ, ટોકન્સ કે API કી હોતી નથી — તમારે નવી સાઇટ પર તેને ફરીથી દાખલ કરવી પડશે."

#: zinn/class-zinn-cache-pro-admin-ui.php:1013
msgid "Settings saved."
msgstr "સેટિંગ્સ સાચવવામાં આવી છે."

#: zinn/class-zinn-cache-pro-admin-ui.php:1060
msgid "Every setting on this plugin is back to its default."
msgstr "આ પ્લગઇનની દરેક સેટિંગ તેના ડિફૉલ્ટ પર પાછી આવી ગઈ છે."

#: zinn/class-zinn-cache-pro-admin-ui.php:1103
msgid "Done."
msgstr "પૂર્ણ થયું."

#: zinn/class-zinn-cache-pro-admin-ui.php:1107
msgid "That action is not available."
msgstr "તે ક્રિયા ઉપલબ્ધ નથી."

#: zinn/class-zinn-cache-pro-admin-ui.php:1174
msgid "That file could not be read. Choose a settings file exported from a Zinn® plugin."
msgstr "પેલી ફાઇલ વાંચી શકાઈ નહીં. Zinn® પ્લગઇનમાંથી નિકાસ કરેલી સેટિંગ્સ ફાઇલ પસંદ કરો."

#: zinn/class-zinn-cache-pro-admin-ui.php:1182
msgid "That file is too large to be a settings export."
msgstr "તે ફાઇલ સેટિંગ્સ નિકાસ માટે ખૂબ મોટી છે."

#: zinn/class-zinn-cache-pro-admin-ui.php:1195
msgid "That file is not a Zinn® settings export."
msgstr "તે ફાઇલ Zinn® સેટિંગ્સ નિકાસ નથી."

#. translators: %s: the plugin slug the file was exported from.
#: zinn/class-zinn-cache-pro-admin-ui.php:1203
#, php-format
msgid "That file was exported from a different plugin (%s), so importing it here would store settings this plugin does not understand."
msgstr "તે ફાઇલ અલગ પ્લગઇન (%s) માંથી એક્સપોર્ટ કરવામાં આવી હતી, તેથી તેને અહીં ઇમ્પોર્ટ કરવાથી એવી સેટિંગ્સ સ્ટોર થશે જે આ પ્લગઇન સમજી શકતું નથી."

#. translators: %d: how many settings were imported.
#: zinn/class-zinn-cache-pro-admin-ui.php:1233
#, php-format
msgid "%d setting imported. Passwords and API keys are never in an export, so enter those again."
msgid_plural "%d settings imported. Passwords and API keys are never in an export, so enter those again."
msgstr[0] "%d સેટિંગ આયાત કરવામાં આવી છે. પાસવર્ડ્સ અને API કી ક્યારેય એક્સપોર્ટમાં હોતી નથી, તેથી તેને ફરીથી દાખલ કરો."
msgstr[1] "%d સેટિંગ્સ આયાત કરવામાં આવ્યા. પાસવર્ડ્સ અને API કીઝ ક્યારેય નિકાસમાં હોતા નથી, તેથી તેમને ફરીથી દાખલ કરો."

#: zinn/class-zinn-cache-pro-connection.php:58
