msgstr "የZinn® መሸጎጫ ሞተር (Cache Engine) የማዋቀሪያ ቅድመ-ቅምጦች"

#: tpl/presets/standard.tpl.php:17
msgid "Essentials"
msgstr "መሠረታዊ ነገሮች"

#: tpl/presets/standard.tpl.php:19
msgid "Default Cache"
msgstr "ነባሪ መሸጎጫ"

