msgstr "Belgedeki resimler, CSS, JavaScript ve benzerleri dahil tüm URL'ler için DNS ön getirmesini (prefetching) otomatik olarak etkinleştirin."

#: tpl/page_optm/settings_html.tpl.php:61
msgid "This can improve the page loading speed."
msgstr "Bu, sayfa yükleme hızını artırabilir."

#: tpl/page_optm/settings_html.tpl.php:75
