msgstr "JS hatası, sağ tıklayıp İncele seçeneği kullanılarak tarayıcının geliştirici konsolundan bulunabilir."

#: tpl/page_optm/settings_js.tpl.php:66
#, php-format
msgid "Include external JS and inline JS in combined file when %1$s is also enabled. This option helps maintain the priorities of JS execution, which should minimize potential errors caused by JS Combine."
msgstr "%1$s da etkinleştirildiğinde harici JS ve satır içi JS dosyalarını birleştirilmiş dosyaya dahil edin. Bu seçenek, JS Combine tarafından yapılabilecek olası hataları en aza indirmesi gereken JS yürütme önceliklerinin korunmasına yardımcı olur."

#: tpl/page_optm/settings_js.tpl.php:77
msgid "Deferred"
msgstr "Ertelenmiş"

#: tpl/page_optm/settings_js.tpl.php:77
msgid "Delayed"
msgstr "Gecikmiş"

#: tpl/page_optm/settings_js.tpl.php:79
