msgid "Enabling Zinn® Cache Engine for WordPress here enables the cache for the network."
msgstr "ഇവിടെ WordPress-നായുള്ള Zinn® cache engine പ്രവർത്തനക്ഷമമാക്കുന്നത് നെറ്റ്‌വർക്കിനായുള്ള കാഷെ പ്രവർത്തനക്ഷമമാക്കുന്നു."

#: tpl/cache/network_settings-cache.tpl.php:29
msgid "It is STRONGLY recommended that the compatibility with other plugins on a single/few sites is tested first."
msgstr "ഒറ്റപ്പെട്ടതോ കുറഞ്ഞതോ ആയ സൈറ്റുകളിൽ മറ്റ് പ്ലഗിനുകളുമായുള്ള അനുയോജ്യത ആദ്യം പരിശോധിക്കണമെന്ന് ശക്തമായി ശുപാർശ ചെയ്യുന്നു."

#: tpl/cache/network_settings-cache.tpl.php:30
msgid "This is to ensure compatibility prior to enabling the cache for all sites."
msgstr "എല്ലാ സൈറ്റുകൾക്കുമായി കാഷെ പ്രവർത്തനക്ഷമമാക്കുന്നതിന് മുമ്പ് അനുയോജ്യത ഉറപ്പാക്കാനാണ് ഇത്."

