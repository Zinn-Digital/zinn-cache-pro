msgstr "Trì hoãn hiển thị các phần tử HTML ngoài màn hình theo bộ chọn của chúng."

#: tpl/page_optm/settings_html.tpl.php:106
msgid "When minifying HTML do not discard comments that match a specified pattern."
msgstr "Khi thu gọn HTML, không loại bỏ các chú thích khớp với một mẫu đã chỉ định."

