msgstr "Để loại trừ %1$s, hãy chèn %2$s."

#: tpl/cache/settings-excludes.tpl.php:135
msgid "Selected roles will be excluded from cache."
msgstr "Các vai trò được chọn sẽ bị loại khỏi bộ nhớ đệm."

