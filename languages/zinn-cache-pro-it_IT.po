msgstr "Il prefetching DNS può ridurre la latenza per i visitatori."

#: tpl/page_optm/settings_html.tpl.php:45
#: tpl/page_optm/settings_html.tpl.php:76
msgid "For example"
msgstr "Ad esempio"

