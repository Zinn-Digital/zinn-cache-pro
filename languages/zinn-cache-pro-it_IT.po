msgstr "L'elenco predefinito verrà inoltre combinato con le impostazioni di cui sopra."

#: tpl/page_optm/settings_tuning.tpl.php:85
msgid "Listed JS files or inline JS code will not be deferred or delayed."
msgstr "I file JS elencati o il codice JS inline non saranno differiti o ritardati."

#: tpl/page_optm/settings_tuning.tpl.php:106
#, php-format
