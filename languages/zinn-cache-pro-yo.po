msgstr "Akojọ URI ti a fun kii yoo ṣe ina UCSS."

#: tpl/page_optm/settings_tuning_css.tpl.php:99
#, php-format
msgid "Use %1$s to generate one single UCSS for the pages which page type is %2$s while other page types still per URL."
msgstr "Lo %1$s lati da UCSS kan soso jade fun awọn oju-iwe ti iru oju-iwe wọn jẹ %2$s lakoko ti awọn iru oju-iwe miiran n tẹsiwaju fun URL kọọkan."

#: tpl/page_optm/settings_tuning_css.tpl.php:100
#, php-format
msgid "Use %1$s to bypass UCSS for the pages which page type is %2$s."
msgstr "Lo %1$s lati fọ UCSS kọja fun awọn oju-iwe ti iru oju-iwe jẹ %2$s."

