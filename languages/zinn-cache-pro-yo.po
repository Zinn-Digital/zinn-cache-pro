msgstr "Mejeeji %1$s ati %2$s jẹ́ itẹwọgba."

#: tpl/cache/settings-purge.tpl.php:116
msgid "For URLs with wildcards, there may be a delay in initiating scheduled purge."
msgstr "Fún àwọn URL pẹ̀lú wildcard, ìdádúró le wà ní bíbẹ̀rẹ̀ ìṣẹ̀tọ́ tí a ṣètò fún ìparẹ́."

#: tpl/cache/settings-purge.tpl.php:131
#, php-format
msgid "Specify the time to purge the \"%s\" list."
msgstr "Sọ akoko lati nu akojọ \"%s\" kuro."

