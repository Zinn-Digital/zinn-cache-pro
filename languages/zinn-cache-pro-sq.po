msgstr "Çaktivizimi i këtij opsioni mund të ndikojë negativisht te performanca."

#: tpl/cache/settings-cache.tpl.php:116
msgid "URI Paths containing these strings will NOT be cached as public."
msgstr "Shtigjet e URI-ve që përmbajnë këto vargje NUK do të ruhen në cache si publike."

#: tpl/cache/settings-cache.tpl.php:130
msgid "Paths containing these strings will be cached regardless of no-cacheable settings."
msgstr "Shtigjet që përmbajnë këto vargje do të ruhen në cache pavarësisht nga cilësimet pa cache."

#: tpl/cache/settings-cache.tpl.php:133
#: tpl/cache/settings-cache.tpl.php:158
msgid "To define a custom TTL for a URI, add a space followed by the TTL value to the end of the URI."
msgstr "Për të përcaktuar një TTL të personalizuar për një URI, shtoni një hapësirë të ndjekur nga vlera e TTL-së në fund të URI-së."

#: tpl/cache/settings-cache.tpl.php:136
#: tpl/cache/settings-cache.tpl.php:161
#, php-format
msgid "For example, %1$s defines a TTL of %2$s seconds for %3$s."
msgstr "Për shembull, %1$s përcakton një TTL prej %2$s sekondash për %3$s."

#: tpl/cache/settings-cache.tpl.php:155
msgid "Paths containing these strings will be forced to public cached regardless of no-cacheable settings."
msgstr "Shtigjet që përmbajnë këto vargje do të detyrohen të ruhen në cache publikisht, pavarësisht nga cilësimet për mosruajtje në cache."

#: tpl/cache/settings-esi.tpl.php:15
msgid "ESI Settings"
msgstr "Cilësimet ESI"

#: tpl/cache/settings-esi.tpl.php:20
msgid "With ESI (Edge Side Includes), pages may be served from cache for logged-in users."
msgstr "Me ESI (Edge Side Includes), faqet mund të shërbehen nga memorja cache për përdoruesit e kyçur."

#: tpl/cache/settings-esi.tpl.php:21
msgid "ESI allows you to designate parts of your dynamic page as separate fragments that are then assembled together to make the whole page. In other words, ESI lets you “punch holes” in a page, and then fill those holes with content that may be cached privately, cached publicly with its own TTL, or not cached at all."
msgstr "ESI ju lejonë të caktoni pjesë të faqes suaj dinamike si fragmente të veçanta të cilat më pas bashkohen së bashku për të formuar të gjithë faqen. Me fjalë të tjera, ESI ju lejon të “hapni vrima” në një faqe, dhe më pas t'i mbushni ato vrima me përmbajtje që mund të ruhet në cache privatisht, publikisht me TTL-në e saj, ose të mos ruhet fare në cache."

#: tpl/cache/settings-esi.tpl.php:22
msgid "WpW: Private Cache vs. Public Cache"
msgstr "WpW: Cache Private vs. Cache Publike"

#: tpl/cache/settings-esi.tpl.php:26
msgid "You can turn shortcodes into ESI blocks."
msgstr "Ju mund t'i ktheni shkurtoret në blloke ESI."

#: tpl/cache/settings-esi.tpl.php:29
#, php-format
msgid "Replace %1$s with %2$s."
msgstr "Zëvendëso %1$s me %2$s."

#: tpl/cache/settings-esi.tpl.php:37
