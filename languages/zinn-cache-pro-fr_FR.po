msgstr "Il sera converti à la volée en espace réservé SVG en base64."

#: tpl/page_optm/settings_media.tpl.php:92
#, php-format
msgid "Variables %s will be replaced with the corresponding image properties."
msgstr "Les variables %s seront remplacées par les propriétés d'image correspondantes."

#: tpl/page_optm/settings_media.tpl.php:93
#, php-format
