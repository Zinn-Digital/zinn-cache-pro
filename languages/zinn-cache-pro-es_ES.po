msgstr "Combine todos los archivos JS locales en un solo archivo."

#: tpl/page_optm/settings_js.tpl.php:51
#: tpl/page_optm/settings_js.tpl.php:85
msgid "This option may result in a JS error or layout issue on frontend pages with certain themes/plugins."
msgstr "Esta opción puede provocar un error de JS o un problema de diseño en las páginas públicas con ciertos temas o plugins."

#: tpl/page_optm/settings_js.tpl.php:52
msgid "JS error can be found from the developer console of browser by right clicking and choosing Inspect."
msgstr "El error de JS se puede encontrar en la consola de desarrollador del navegador haciendo clic derecho y eligiendo Inspeccionar."

#: tpl/page_optm/settings_js.tpl.php:66
#, php-format
msgid "Include external JS and inline JS in combined file when %1$s is also enabled. This option helps maintain the priorities of JS execution, which should minimize potential errors caused by JS Combine."
msgstr "Incluir JS externo y JS en línea en el archivo combinado cuando %1$s también esté habilitado. Esta opción ayuda a mantener las prioridades de ejecución de JS, lo que debería minimizar los posibles errores causados por JS Combine."

#: tpl/page_optm/settings_js.tpl.php:77
msgid "Deferred"
msgstr "Aplazado"

#: tpl/page_optm/settings_js.tpl.php:77
msgid "Delayed"
msgstr "Retrasado"

#: tpl/page_optm/settings_js.tpl.php:79
msgid "Deferring until page is parsed or delaying till interaction can help reduce resource contention and improve performance causing a lower FID (Core Web Vitals metric)."
msgstr "Diferir hasta que la página esté analizada o retrasar hasta la interacción puede ayudar a reducir la contención de recursos y mejorar el rendimiento, lo que provoca un FID (métrica de Core Web Vitals) más bajo."

#: tpl/page_optm/settings_localization.tpl.php:26
#, php-format
