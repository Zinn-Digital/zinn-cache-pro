msgstr "No se enviarán solicitudes LQIP para imágenes en las que tanto el ancho como el alto sean menores que estas dimensiones."

#: tpl/page_optm/settings_media.tpl.php:172
msgid "Automatically generate LQIP in the background via a cron-based queue."
msgstr "Generar automáticamente LQIP en segundo plano mediante una cola basada en cron."

#: tpl/page_optm/settings_media.tpl.php:175
#, php-format
msgid "If set to %1$s, before the placeholder is localized, the %2$s configuration will be used."
msgstr "Si se establece en %1$s, antes de que se localice el marcador de posición, se utilizará la configuración %2$s."

