msgstr "Esto también agregará un preconnect a Google Fonts para establecer una conexión antes."

#: tpl/page_optm/settings_html.tpl.php:161
msgid "Prevent Google Fonts from loading on all pages."
msgstr "Evitar que Google Fonts se cargue en todas las páginas."

#: tpl/page_optm/settings_html.tpl.php:174
msgid "Stop loading WordPress.org emoji. Browser default emoji will be displayed instead."
msgstr "Dejar de cargar los emojis de WordPress.org. En su lugar, se mostrarán los emojis predeterminados del navegador."

#: tpl/page_optm/settings_html.tpl.php:188
#, php-format
msgid "This option will remove all %s tags from HTML."
msgstr "Esta opción eliminará todas las etiquetas %s del código HTML."

#: tpl/page_optm/settings_js.tpl.php:33
