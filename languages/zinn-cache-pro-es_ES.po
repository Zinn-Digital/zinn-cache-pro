msgstr "Cargar las imágenes solo cuando entren en la ventana gráfica."

#: tpl/page_optm/settings_media.tpl.php:41
#: tpl/page_optm/settings_media.tpl.php:235
msgid "This can improve page loading time by reducing initial HTTP requests."
msgstr "Esto puede mejorar el tiempo de carga de la página al reducir las solicitudes HTTP iniciales."

