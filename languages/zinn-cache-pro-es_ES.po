msgstr "Los cambios en esta configuración no se aplican a los LQIP ya generados. Para volver a generar los LQIP existentes, primero %s desde el menú de la barra de administración."

#: tpl/page_optm/settings_media.tpl.php:154
msgid "pixels"
msgstr "píxeles"

#: tpl/page_optm/settings_media.tpl.php:156
