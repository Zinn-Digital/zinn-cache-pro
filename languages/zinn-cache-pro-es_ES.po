msgstr "Al minificar HTML, no descartes los comentarios que coincidan con un patrón especificado."

#: tpl/page_optm/settings_html.tpl.php:108
#, php-format
msgid "If comment to be kept is like: %1$s write: %2$s"
msgstr "Si el comentario que debe conservarse es como: %1$s escriba: %2$s"

