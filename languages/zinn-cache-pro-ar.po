msgstr "استيراد / تصدير"

#: tpl/presets/entry.tpl.php:23
msgid "Zinn® Cache Engine Configuration Presets"
msgstr "إعدادات مسبقة لتكوين محرك التخزين المؤقت Zinn®"

#: tpl/presets/standard.tpl.php:17
msgid "Essentials"
msgstr "الأساسيات"

#: tpl/presets/standard.tpl.php:19
msgid "Default Cache"
msgstr "ذاكرة التخزين المؤقت الافتراضية"

#: tpl/presets/standard.tpl.php:20
msgid "Higher TTL"
msgstr "TTL أعلى"

#: tpl/presets/standard.tpl.php:24
msgid "This no-risk preset is appropriate for all websites. Good for new users, simple websites, or cache-oriented development."
msgstr "هذا الإعداد المسبق الخالي من المخاطر مناسب لجميع مواقع الويب. وهو جيد للمستخدمين الجدد، أو مواقع الويب البسيطة، أو التطوير الموجه ذاكرة التخزين المؤقت."

