#, php-format
msgid "%d setting imported. Passwords and API keys are never in an export, so enter those again."
msgid_plural "%d settings imported. Passwords and API keys are never in an export, so enter those again."
msgstr[0] "Ներմուծվեց %d կարգավորում: Գաղտնաբառերը և API բանալիները չեն ներառվում արտահանման մեջ, ուստի անհրաժեշտ է դրանք նորից մուտքագրել:"
msgstr[1] "%d կարգավորում ներմուծվել է: Գաղտնաբառերն ու API բանալիները երբեք չեն ներառվում արտահանման մեջ, ուստի դրանք նորից մուտքագրեք:"

