msgstr "Bij URL's met jokers kan er vertraging optreden bij het starten van de geplande opschoning."

#: tpl/cache/settings-purge.tpl.php:131
#, php-format
msgid "Specify the time to purge the \"%s\" list."
msgstr "Geef de tijd op om de lijst \"%s\" te legen."

