msgstr "כל העמודים"

#: tpl/cache/settings-purge.tpl.php:22
msgid "Front page"
msgstr "עמוד ראשי"

#: tpl/cache/settings-purge.tpl.php:23
msgid "Home page"
msgstr "דף הבית"

#: tpl/cache/settings-purge.tpl.php:24
