msgstr "אם מזהה התגית (slug) לא נמצא, התגית תוסר מהרשימה בעת השמירה."

#: tpl/cache/settings-excludes.tpl.php:110
#, php-format
msgid "To exclude %1$s, insert %2$s."
msgstr "כדי להחריג את %1$s, הוסף את %2$s."

#: tpl/cache/settings-excludes.tpl.php:135
msgid "Selected roles will be excluded from cache."
msgstr "תפקידים נבחרים יוחרגו מהמטמון."

