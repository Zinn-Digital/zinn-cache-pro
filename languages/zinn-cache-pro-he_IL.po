msgstr "כל העמודים עם וידג'ט הפוסטים האחרונים"

#: tpl/cache/settings-purge.tpl.php:26
msgid "Author archive"
msgstr "ארכיון מחבר"

#: tpl/cache/settings-purge.tpl.php:27
