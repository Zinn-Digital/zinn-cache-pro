msgid "Selectors must exist in the CSS. Parent classes in the HTML will not work."
msgstr "სელექტორები უნდა არსებობდეს CSS-ში. HTML-ის მშობელი კლასები არ იმუშავებს."

#: tpl/page_optm/settings_tuning_css.tpl.php:167
#, php-format
msgid "Specify critical CSS rules for above-the-fold content when enabling %s."
msgstr "მიუთითეთ კრიტიკული CSS წესები ეკრანის ზედა ნაწილში მოსათავსებელი კონტენტისთვის %s-ის ჩართვისას."

#: tpl/page_optm/settings_vpi.tpl.php:37
