msgid "Disable this option to generate CCSS per Post Type instead of per page. This can save significant CCSS quota, however it may result in incorrect CSS styling if your site uses a page builder."
msgstr "Har bir sahifa o‘rniga har bir post turi uchun CCSS yaratish uchun ushbu opsiyani o‘chirib qo‘ying. Bu CCSS kvotasini sezilarli darajada tejashi mumkin, biroq saytingiz sahifa konstruktoridan foydalansa, CSS uslublarining noto‘g‘ri chiqishiga olib kelishi mumkin."

#: tpl/page_optm/settings_css.tpl.php:327
msgid "This will inline the asynchronous CSS library to avoid render blocking."
msgstr "Bu render bloklanishining oldini olish uchun asinxron CSS kutubxonasini inlayn qiladi."

#: tpl/page_optm/settings_css.tpl.php:338
msgid "Default"
msgstr "Standart"

#: tpl/page_optm/settings_css.tpl.php:340
#, php-format
