msgstr "Chegarani oʻzgartirish uchun %s filtri mavjud."

#: tpl/page_optm/settings_media_exc.tpl.php:31
msgid "Listed images will not be lazy loaded."
msgstr "Ro‘yxatga kiritilgan rasmlar kechiktirib yuklanmaydi."

#: tpl/page_optm/settings_media_exc.tpl.php:34
msgid "Useful for above-the-fold images causing CLS (a Core Web Vitals metric)."
msgstr "CLS ga (Core Web Vitals metrikasi) sabab bo'ladigan sahifaning yuqori qismidagi (above-the-fold) rasmlar uchun foydali."

