msgstr "Moslashuvchan joy egasi SVG rangini belgilang."

#: tpl/page_optm/settings_media.tpl.php:122
msgid "Use QUIC.cloud LQIP (Low Quality Image Placeholder) generator service for responsive image previews while loading."
msgstr "Yuklanayotgan paytda moslashuvchan rasm namoyishlari uchun QUIC.cloud LQIP (Low Quality Image Placeholder) generator xizmatidan foydalaning."

#: tpl/page_optm/settings_media.tpl.php:123
msgid "Keep this off to use plain color placeholders."
msgstr "Oddiy rangli to'ldirgichlardan foydalanish uchun buni o'chirib qo'ying."

