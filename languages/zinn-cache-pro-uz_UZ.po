msgstr "Oldindan ulanish ma'lum bir manbadan kelgusidagi yuklanishlarni tezlashtiradi."

#: tpl/page_optm/settings_html.tpl.php:91
msgid "Delay rendering off-screen HTML elements by its selector."
msgstr "Ekrandan tashqaridagi HTML elementlarini selektori bo'yicha render qilishni kechiktirish."

#: tpl/page_optm/settings_html.tpl.php:106
msgid "When minifying HTML do not discard comments that match a specified pattern."
msgstr "HTML'ni kichraytirishda belgilangan qoidaga mos keladigan izohlarni olib tashlamang."

#: tpl/page_optm/settings_html.tpl.php:108
#, php-format
msgid "If comment to be kept is like: %1$s write: %2$s"
msgstr "Agar saqlanishi kerak bo'lgan izoh quyidagicha bo'lsa: %1$s yozing: %2$s"

#: tpl/page_optm/settings_html.tpl.php:123
msgid "Remove query strings from internal static resources."
msgstr "Ichki statik resurslardan so'rov qatorlarini olib tashlang."

