#: tpl/cache/settings-cache.tpl.php:45
msgid "The network admin setting can be overridden here."
msgstr "ਇੱਥੇ ਨੈੱਟਵਰਕ ਐਡਮਿਨ ਸੈਟਿੰਗ ਨੂੰ ਬਦਲਿਆ ਜਾ ਸਕਦਾ ਹੈ।"

#: tpl/cache/settings-cache.tpl.php:60
#, php-format
msgid "Privately cache frontend pages for logged-in users. (LSWS %s required)"
msgstr "ਲਾਗ-ਇਨ ਕੀਤੇ ਉਪਭੋਗਤਾਵਾਂ ਲਈ ਫਰੰਟਐਂਡ ਪੰਨਿਆਂ ਨੂੰ ਨਿੱਜੀ ਤੌਰ 'ਤੇ ਕੈਸ਼ ਕਰੋ। (LSWS %s ਲੋੜੀਂਦਾ ਹੈ)"

#: tpl/cache/settings-cache.tpl.php:73
#, php-format
msgid "Privately cache commenters that have pending comments. Disabling this option will serve non-cacheable pages to commenters. (LSWS %s required)"
msgstr "ਉਨ੍ਹਾਂ ਟਿੱਪਣੀਕਾਰਾਂ ਨੂੰ ਨਿੱਜੀ ਤੌਰ 'ਤੇ ਕੈਸ਼ ਕਰੋ ਜਿਨ੍ਹਾਂ ਦੀਆਂ ਟਿੱਪਣੀਆਂ ਬਕਾਇਆ ਹਨ। ਇਸ ਵਿਕਲਪ ਨੂੰ ਅਯੋਗ ਕਰਨ ਨਾਲ ਟਿੱਪਣੀਕਾਰਾਂ ਨੂੰ ਗੈਰ-ਕੈਸ਼ ਕਰਨ ਯੋਗ ਪੰਨੇ ਦਿਖਾਈ ਦੇਣਗੇ। (LSWS %s ਲੋੜੀਂਦਾ ਹੈ)"

#: tpl/cache/settings-cache.tpl.php:86
msgid "Cache requests made by WordPress REST API calls."
msgstr "WordPress REST API ਕਾਲਾਂ ਦੁਆਰਾ ਕੀਤੀਆਂ ਗਈਆਂ ਕੈਸ਼ ਬੇਨਤੀਆਂ।"

#: tpl/cache/settings-cache.tpl.php:99
msgid "Disabling this option may negatively affect performance."
msgstr "ਇਸ ਵਿਕਲਪ ਨੂੰ ਅਯੋਗ ਕਰਨ ਨਾਲ ਪ੍ਰਦਰਸ਼ਨ 'ਤੇ ਨਕਾਰਾਤਮਕ ਅਸਰ ਪੈ ਸਕਦਾ ਹੈ।"

#: tpl/cache/settings-cache.tpl.php:116
msgid "URI Paths containing these strings will NOT be cached as public."
msgstr "ਇਹਨਾਂ ਸਟ੍ਰਿੰਗਾਂ ਵਾਲੇ URI ਮਾਰਗ (Paths) ਜਨਤਕ ਤੌਰ 'ਤੇ ਕੈਸ਼ (cached) ਨਹੀਂ ਕੀਤੇ ਜਾਣਗੇ।"

#: tpl/cache/settings-cache.tpl.php:130
msgid "Paths containing these strings will be cached regardless of no-cacheable settings."
msgstr "ਇਹਨਾਂ ਸਤਰਾਂ ਵਾਲੇ ਮਾਰਗਾਂ ਨੂੰ ਨੋ-ਕੈਸ਼ੇਬਲ (no-cacheable) ਸੈਟਿੰਗਾਂ ਦੇ ਬਾਵਜੂਦ ਕੈਸ਼ ਕੀਤਾ ਜਾਵੇਗਾ।"

#: tpl/cache/settings-cache.tpl.php:133
#: tpl/cache/settings-cache.tpl.php:158
msgid "To define a custom TTL for a URI, add a space followed by the TTL value to the end of the URI."
msgstr "ਕਿਸੇ URI ਲਈ ਕਸਟਮ TTL ਪਰਿਭਾਸ਼ਿਤ ਕਰਨ ਲਈ, URI ਦੇ ਅੰਤ ਵਿੱਚ ਇੱਕ ਸਪੇਸ ਅਤੇ ਉਸ ਤੋਂ ਬਾਅਦ TTL ਮੁੱਲ ਸ਼ਾਮਲ ਕਰੋ।"

#: tpl/cache/settings-cache.tpl.php:136
#: tpl/cache/settings-cache.tpl.php:161
#, php-format
msgid "For example, %1$s defines a TTL of %2$s seconds for %3$s."
msgstr "ਉਦਾਹਰਣ ਵਜੋਂ, %1$s, %3$s ਲਈ %2$s ਸਕਿੰਟਾਂ ਦਾ TTL ਪਰਿਭਾਸ਼ਿਤ ਕਰਦਾ ਹੈ।"

#: tpl/cache/settings-cache.tpl.php:155
msgid "Paths containing these strings will be forced to public cached regardless of no-cacheable settings."
msgstr "ਇਹਨਾਂ ਸਟ੍ਰਿੰਗਾਂ ਵਾਲੇ ਮਾਰਗਾਂ (Paths) ਨੂੰ ਨੋ-ਕੈਸ਼ੇਬਲ (no-cacheable) ਸੈਟਿੰਗਾਂ ਦੇ ਬਾਵਜੂਦ ਲਾਜ਼ਮੀ ਤੌਰ 'ਤੇ ਪਬਲਿਕ ਕੈਸ਼ਡ ਕੀਤਾ ਜਾਵੇਗਾ।"

#: tpl/cache/settings-esi.tpl.php:15
msgid "ESI Settings"
msgstr "ESI ਸੈਟਿੰਗਾਂ"

#: tpl/cache/settings-esi.tpl.php:20
msgid "With ESI (Edge Side Includes), pages may be served from cache for logged-in users."
msgstr "ESI (Edge Side Includes) ਨਾਲ, ਲੌਗ-ਇਨ ਕੀਤੇ ਉਪਭੋਗਤਾਵਾਂ ਲਈ ਕੈਸ਼ ਤੋਂ ਪੰਨੇ ਸਰਵ ਕੀਤੇ ਜਾ ਸਕਦੇ ਹਨ।"

#: tpl/cache/settings-esi.tpl.php:21
msgid "ESI allows you to designate parts of your dynamic page as separate fragments that are then assembled together to make the whole page. In other words, ESI lets you “punch holes” in a page, and then fill those holes with content that may be cached privately, cached publicly with its own TTL, or not cached at all."
msgstr "ESI ਤੁਹਾਨੂੰ ਤੁਹਾਡੇ ਡਾਇਨਾਮਿਕ ਪੰਨੇ ਦੇ ਹਿੱਸਿਆਂ ਨੂੰ ਵੱਖ-ਵੱਖ ਫ੍ਰੈਗਮੈਂਟਸ ਵਜੋਂ ਨਾਮਜ਼ਦ ਕਰਨ ਦੀ ਇਜਾਜ਼ਤ ਦਿੰਦਾ ਹੈ ਜੋ ਬਾਅਦ ਵਿੱਚ ਪੂਰੇ ਪੰਨੇ ਨੂੰ ਬਣਾਉਣ ਲਈ ਇਕੱਠੇ ਕੀਤੇ ਜਾਂਦੇ ਹਨ। ਦੂਜੇ ਸ਼ਬਦਾਂ ਵਿੱਚ, ESI ਤੁਹਾਨੂੰ ਕਿਸੇ ਪੰਨੇ ਵਿੱਚ “ਛੇਕ ਕਰਨ” ਅਤੇ ਫਿਰ ਉਹਨਾਂ ਛੇਕਾਂ ਨੂੰ ਅਜਿਹੀ ਸਮੱਗਰੀ ਨਾਲ ਭਰਨ ਦੀ ਇਜਾਜ਼ਤ ਦਿੰਦਾ ਹੈ ਜਿਸ ਨੂੰ ਨਿੱਜੀ ਤੌਰ 'ਤੇ ਕੈਸ਼ ਕੀਤਾ ਜਾ ਸਕਦਾ ਹੈ, ਇਸਦੇ ਆਪਣੇ TTL ਨਾਲ ਜਨਤਕ ਤੌਰ 'ਤੇ ਕੈਸ਼ ਕੀਤਾ ਜਾ ਸਕਦਾ ਹੈ, ਜਾਂ ਬਿਲਕੁਲ ਵੀ ਕੈਸ਼ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ ਹੈ।"

#: tpl/cache/settings-esi.tpl.php:22
msgid "WpW: Private Cache vs. Public Cache"
msgstr "WpW: ਪ੍ਰਾਈਵੇਟ ਕੈਸ਼ ਬਨਾਮ ਪਬਲਿਕ ਕੈਸ਼"

#: tpl/cache/settings-esi.tpl.php:26
msgid "You can turn shortcodes into ESI blocks."
msgstr "ਤੁਸੀਂ ਸ਼ਾਰਟਕੋਡਾਂ ਨੂੰ ESI ਬਲਾਕਾਂ ਵਿੱਚ ਬਦਲ ਸਕਦੇ ਹੋ।"

#: tpl/cache/settings-esi.tpl.php:29
