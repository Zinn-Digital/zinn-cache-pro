msgstr "ਗੈਸਟ ਮੋਡ ਅਤੇ ਗੈਸਟ ਓਪਟੀਮਾਈੱੇਸ਼ਨ"

#: tpl/presets/standard.tpl.php:45
msgid "CSS, JS and HTML Minification"
msgstr "CSS, JS ਅਤੇ HTML ਮਿਨੀਫ਼ਿਕੇਸ਼ਨ"

