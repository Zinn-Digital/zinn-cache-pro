msgstr "Όλες οι ετικέτες αποθηκεύονται στην cache από προεπιλογή."

#: tpl/cache/settings-excludes.tpl.php:100
msgid "tags"
msgstr "ετικέτες"

#: tpl/cache/settings-excludes.tpl.php:106
msgid "If the tag slug is not found, the tag will be removed from the list on save."
msgstr "Εάν δεν βρεθεί το αναγνωριστικό (slug) της ετικέτας, η ετικέτα θα αφαιρεθεί από τη λίστα κατά την αποθήκευση."

#: tpl/cache/settings-excludes.tpl.php:110
#, php-format
msgid "To exclude %1$s, insert %2$s."
msgstr "Για να εξαιρέσετε το %1$s, εισαγάγετε το %2$s."

#: tpl/cache/settings-excludes.tpl.php:135
msgid "Selected roles will be excluded from cache."
msgstr "Οι επιλεγμένοι ρόλοι θα εξαιρεθούν από την προσωinική μνήμη."

