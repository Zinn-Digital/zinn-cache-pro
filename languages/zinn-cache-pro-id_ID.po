msgid "Disable this option to generate CCSS per Post Type instead of per page. This can save significant CCSS quota, however it may result in incorrect CSS styling if your site uses a page builder."
msgstr "Nonaktifkan opsi ini untuk menghasilkan CCSS per Jenis Pos alih-alih per halaman. Hal ini dapat menghemat kuota CCSS secara signifikan, namun dapat mengakibatkan gaya CSS yang salah jika situs Anda menggunakan pembangun halaman."

#: tpl/page_optm/settings_css.tpl.php:327
msgid "This will inline the asynchronous CSS library to avoid render blocking."
msgstr "Ini akan menyisipkan pustaka CSS asinkron secara inline untuk menghindari pemblokiran rendering."

#: tpl/page_optm/settings_css.tpl.php:338
msgid "Default"
msgstr "Bawaan"

#: tpl/page_optm/settings_css.tpl.php:340
#, php-format
msgid "Set this to append %1$s to all %2$s rules before caching CSS to specify how fonts should be displayed while being downloaded."
msgstr "Atur ini untuk menambahkan %1$s ke semua aturan %2$s sebelum melakukan *caching* CSS untuk menentukan bagaimana fon harus ditampilkan saat diunduh."

#: tpl/page_optm/settings_css.tpl.php:341
#, php-format
msgid "%s is recommended."
msgstr "%s direkomendasikan."

#: tpl/page_optm/settings_css.tpl.php:341
msgid "Swap"
msgstr "Tukar"

#: tpl/page_optm/settings_html.tpl.php:31
